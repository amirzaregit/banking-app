# Copy to .env.production (which is git-ignored) and fill in real values.

# Your public hostname. DNS for it must point at this server, ports 80 and 443 must be open.
DOMAIN=api.example.com

# Generate with:  openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=

# true = a public demo with fake money (keeps the demo deposit button, SMS inbox, card simulator).
# false = removes those endpoints entirely.
DEMO_MODE=true
